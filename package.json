{
  "name": "vscode-typo3-fluid",
  "displayName": "Typo3 Fluid Syntax Highlighting",
  "description": "[DEPRECATED] Syntax highlighting for TYPO3 Fluid — use Fluid Template Language by Friends of TYPO3 instead",
  "version": "0.4.1",
  "publisher": "leon-wbr",
  "contributors": [
    "rp-feflo"
  ],
  "icon": "icons/typo3.png",
  "engines": {
    "vscode": "^1.89.0"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leon-wbr/vscode-typo3-fluid/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leon-wbr/vscode-typo3-fluid"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "typo3",
    "fluid"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fluid",
        "aliases": [
          "Fluid",
          "fluid"
        ],
        "extensions": [
          ".html"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "icons/typo3-transparent.png",
          "dark": "icons/typo3-transparent.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "fluid",
        "scopeName": "source.fluid",
        "path": "./syntaxes/fluid.tmLanguage.json"
      }
    ]
  },
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72",
  "devDependencies": {
    "vscode-test": "^1.6.1",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "scripts": {
    "pretest": "node scripts/fetch-grammars.mjs",
    "test": "vscode-tmgrammar-snap -s source.fluid -g syntaxes/fluid.tmLanguage.json -g test/grammars/html.tmLanguage.json -g test/grammars/html-derivative.tmLanguage.json -g test/grammars/css.tmLanguage.json 'test/fixtures/*.html'",
    "test:update": "yarn pretest && vscode-tmgrammar-snap -u -s source.fluid -g syntaxes/fluid.tmLanguage.json -g test/grammars/html.tmLanguage.json -g test/grammars/html-derivative.tmLanguage.json -g test/grammars/css.tmLanguage.json 'test/fixtures/*.html'"
  }
}
