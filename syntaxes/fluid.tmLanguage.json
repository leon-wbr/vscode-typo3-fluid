{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fluid",
  "scopeName": "source.fluid",
  "fileTypes": ["html"],
  "patterns": [
    {
      "name": "comment.block.html",
      "begin": "(<f:comment(?:\\s[^>]*)?>)",
      "end": "(</f:comment>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.comment.html" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.comment.html" }
      },
      "patterns": [
        {
          "match": "[^<]+|<[^/]|<(?=[^f])",
          "name": "comment.block.html"
        }
      ]
    },
    {
      "include": "#fluid-variables"
    },
    {
      "include": "#fluid-tags"
    },
    {
      "include": "#html-tags-with-fluid"
    },
    {
      "include": "text.html.derivative"
    }
  ],
  "repository": {
    "fluid-variables": {
      "name": "variable.block.html",
      "match": "\\{[^}]*\\}",
      "captures": {
        "0": { "name": "variable.block.html" }
      }
    },
    "fluid-variables-embedded": {
      "name": "variable.block.html",
      "match": "\\{[^\\s{};][^{};]*\\}",
      "captures": {
        "0": { "name": "variable.block.html" }
      }
    },
    "fluid-tags-inline": {
      "patterns": [
        {
          "match": "(<)(f:)([a-zA-Z0-9:.-]+)(\\s[^>]*)?(/?>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.fluid" },
            "3": { "name": "entity.name.tag.fluid" },
            "4": { "name": "entity.other.attribute-name.html" },
            "5": { "name": "punctuation.definition.tag.end.html" }
          }
        },
        {
          "match": "(</)(f:)([a-zA-Z0-9:.-]+)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.fluid" },
            "3": { "name": "entity.name.tag.fluid" },
            "4": { "name": "punctuation.definition.tag.end.html" }
          }
        }
      ]
    },
    "fluid-tag-body": {
      "patterns": [
        {
          "include": "#fluid-variables"
        },
        {
          "match": "\\s+([a-zA-Z0-9:-]+)(=)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "punctuation.separator.key-value.html" }
          }
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.html",
          "patterns": [
            {
              "include": "#fluid-variables"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.html",
          "patterns": [
            {
              "include": "#fluid-variables"
            }
          ]
        }
      ]
    },
    "html-tags-with-fluid": {
      "begin": "(<)(?!(?i:style|script)\\b)([a-zA-Z0-9:-]+)",
      "end": "(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "include": "#fluid-tags"
        },
        {
          "include": "#fluid-tag-body"
        }
      ]
    },
    "fluid-tags": {
      "patterns": [
        {
          "include": "#fluid-tags-inline"
        },
        {
          "begin": "(<)(f:)([a-zA-Z0-9:.-]+)",
          "end": "(/>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.fluid" },
            "3": { "name": "entity.name.tag.fluid" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            {
              "include": "#fluid-tag-body"
            }
          ]
        },
        {
          "begin": "(<)(f:)([a-zA-Z0-9:.-]+)(>)",
          "end": "(</)(f:)([a-zA-Z0-9:.-]+)(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.fluid" },
            "3": { "name": "entity.name.tag.fluid" },
            "4": { "name": "punctuation.definition.tag.end.html" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.fluid" },
            "3": { "name": "entity.name.tag.fluid" },
            "4": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            {
              "include": "#fluid-tag-body"
            }
          ]
        }
      ]
    }
  },
  "injections": {
    "L:meta.selector.css": {
      "patterns": [
        {
          "include": "#fluid-tags-inline"
        },
        {
          "include": "#fluid-variables-embedded"
        }
      ]
    },
    "L:meta.property-value.css": {
      "patterns": [
        {
          "include": "#fluid-tags-inline"
        },
        {
          "include": "#fluid-variables-embedded"
        }
      ]
    },
    "L:meta.property-list.css": {
      "patterns": [
        {
          "include": "#fluid-tags-inline"
        },
        {
          "include": "#fluid-variables-embedded"
        }
      ]
    },
    "L:source.css": {
      "patterns": [
        {
          "include": "#fluid-tags-inline"
        }
      ]
    },
    "L:meta.embedded.block.html": {
      "patterns": [
        {
          "include": "#fluid-tags-inline"
        }
      ]
    }
  }
}
